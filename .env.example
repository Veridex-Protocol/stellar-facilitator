# Veridex Stellar Facilitator v2.0 - Environment Configuration
# License: Apache-2.0
#
# Copy this file to .env and configure your settings

# =============================================================================
# Facilitator Configuration (REQUIRED)
# =============================================================================

# Facilitator Stellar Account (REQUIRED)
# Generate a new testnet account at: https://laboratory.stellar.org/#account-creator?network=test
FACILITATOR_PUBLIC_KEY=
FACILITATOR_SECRET_KEY=

# =============================================================================
# Optional Configuration
# =============================================================================

# MCP Server - Client Stellar Account (for AI agent payments)
STELLAR_CLIENT_SECRET_KEY=

# Reference seller provider-outcome signer. For the demo, use SELLER_SECRET_KEY.
PROVIDER_OUTCOME_SECRET_KEY=

# Internal shared token used for facilitator-to-Bazaar ingestion.
BAZAAR_INTERNAL_TOKEN=

# =============================================================================
# Network Configuration
# =============================================================================

# Stellar Network: testnet or pubnet
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# Facilitator HTTP Server Configuration
# =============================================================================

FACILITATOR_PORT=3002
FACILITATOR_HOST=0.0.0.0

# Host bindings for the local HTTP services. The containers keep their internal
# ports; change these only when another local process owns a default port.
BAZAAR_HOST_PORT=3001
BAZAAR_P2P_HOST_PORT=4001
BAZAAR_P2P_WS_HOST_PORT=4002
FACILITATOR_HOST_PORT=3002
DEMO_SERVER_HOST_PORT=3003
PLAYGROUND_HOST_PORT=3004

# PostgreSQL is reachable by services on the Compose network and is not
# published to the host by default. For localhost-only SQL debugging, use:
# docker compose -f docker-compose.yml -f docker-compose.host-db.yml up -d

# =============================================================================
# Channel Pool Configuration
# =============================================================================

# Safe default uses the facilitator signer. Production channel accounts must
# be persistent secrets; set CHANNEL_AUTO_CREATE only for disposable testing.
CHANNEL_POOL_SIZE=0
CHANNEL_SECRET_KEYS=
CHANNEL_AUTO_CREATE=false

# Cooldown period after channel use in milliseconds (default: 5000)
CHANNEL_COOLDOWN_MS=5000

# Starting balance for each channel account in XLM (default: 5)
CHANNEL_STARTING_BALANCE=5

# Refill threshold - refill when balance drops below this (default: 2)
CHANNEL_REFILL_THRESHOLD=2

# Refill amount in XLM (default: 3)
CHANNEL_REFILL_AMOUNT=3

# =============================================================================
# Service URLs (for local development without Docker)
# =============================================================================

BAZAAR_URL=http://localhost:3001
FACILITATOR_URL=http://localhost:3002
PUBLIC_BAZAAR_URL=http://localhost:3001
PUBLIC_FACILITATOR_URL=http://localhost:3002
PUBLIC_DEMO_SERVER_URL=http://localhost:3003

# Bazaar signed announcements (optional)
BAZAAR_STELLAR_SECRET_KEY=
P2P_ANNOUNCED_RESOURCES=[]
