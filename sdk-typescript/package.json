{
  "name": "@veridex/stellar",
  "version": "0.1.0",
  "description": "Veridex Stellar buyer facade, Bazaar discovery, and advanced facilitator helpers",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/stellar-facilitator.git",
    "directory": "sdk-typescript"
  },
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/stellar-facilitator/issues"
  },
  "homepage": "https://github.com/Veridex-Protocol/stellar-facilitator/tree/dev/sdk-typescript",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "2.21.0",
    "@x402/fetch": "2.21.0",
    "@x402/stellar": "2.21.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "3.2.7"
  },
  "keywords": [
    "veridex",
    "x402",
    "stellar",
    "bazaar",
    "discovery",
    "payment",
    "sdk"
  ]
}
