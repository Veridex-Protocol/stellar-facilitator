# Veridex x402 Stellar facilitator - testnet configuration
# License: Apache-2.0
#
# `npm run setup` generates a working .env with funded Friendbot accounts.
# This file documents every variable for a real deployment.

# ── Network ──────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Facilitator identity ─────────────────────────────────────────────────────
# The secret key must derive the public key; the process refuses to start if it
# does not. The account is the source of every settlement, so it pays the
# Soroban resource fee.
FACILITATOR_SECRET_KEY=
FACILITATOR_PUBLIC_KEY=

# ── Required ─────────────────────────────────────────────────────────────────
# The public origin clients reach this service at. Published in
# /.well-known/x402, so it cannot be inferred from the bind address.
BASE_URL=http://localhost:3002

FACILITATOR_PORT=3002
FACILITATOR_HOST=0.0.0.0

# Optional host bindings for local Docker access. Service-to-service traffic
# uses Compose DNS and is unaffected by these values.
BAZAAR_HOST_PORT=3001
BAZAAR_P2P_HOST_PORT=4001
BAZAAR_P2P_WS_HOST_PORT=4002
FACILITATOR_HOST_PORT=3002
DEMO_SERVER_HOST_PORT=3003
PLAYGROUND_HOST_PORT=3004

# ── Fee sponsorship ──────────────────────────────────────────────────────────
# true  → the facilitator advertises areFeesSponsored and pays fees. Confirmed
#         against Horizon at boot: an unfunded account aborts the start rather
#         than advertising sponsorship it cannot honour.
# false → advertises areFeesSponsored=false; payers pay their own fees.
SPONSOR_FEES=true
# Optional: a separate account to sponsor from. Defaults to the facilitator's.
FEE_BUMP_SIGNER_SECRET=
MAX_TRANSACTION_FEE_STROOPS=1000000

# ── Ledger-skew retry (x402-foundation/x402#3168) ────────────────────────────
# Retries only 'invalid_exact_stellar_signature_expiration_too_far', and never a
# failure that already carries a transaction hash. The delay must outlast one
# ledger close (~5s) or every attempt re-observes the same divergence.
LEDGER_SKEW_RETRIES=2
LEDGER_SKEW_RETRY_DELAY_MS=6000

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Per-instance backstop. Settlement spends real XLM; put a real limiter at the
# edge in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Comma-separated origins, or unset for '*'.
CORS_ORIGINS=

# ── Capability descriptor ────────────────────────────────────────────────────
# Path to the job list served at /.well-known/x402. Unset advertises no jobs,
# which is correct for a facilitator that sells nothing itself.
# See jobs.example.json.
X402_JOBS_FILE=

# ── upto scheme ──────────────────────────────────────────────────────────────
# Advertised only when a contract is confirmed deployed at this id on this
# network. Leave unset until one is. Network-specific, so a testnet id is never
# inherited onto pubnet.
UPTO_ESCROW_CONTRACT_ID_TESTNET=CAHV6TIAOVSICUJHI6OBZSW2N5ZKRPGKHE2SH6OAEJHPHCLF5DXWAGG2
UPTO_ESCROW_CONTRACT_ID_PUBNET=

# ── Settlement throughput (channel accounts) ─────────────────────────────────
# A Stellar account has exactly one sequence number, so settlements from the
# same account cannot overlap. Each funded channel account adds one unit of
# settlement concurrency; the scheduler leases one per in-flight settlement and
# queues the rest rather than letting them collide on a sequence number.
#
# 0 uses the facilitator signer alone, which serializes every settlement. That
# is fine for a smoke test and wrong for bursty agent traffic.
# `npm run setup` provisions 3 funded channels by default (CHANNEL_COUNT).
CHANNEL_POOL_SIZE=0
CHANNEL_SECRET_KEYS=

# How long a settlement waits for a free signer before being refused with
# 'settlement_capacity_exceeded'. A prompt, explicit refusal that says no funds
# moved beats a request that hangs until something upstream times out.
SETTLE_QUEUE_TIMEOUT_MS=30000
CHANNEL_AUTO_CREATE=false
CHANNEL_COOLDOWN_MS=5000
CHANNEL_STARTING_BALANCE=5
CHANNEL_REFILL_THRESHOLD=2
CHANNEL_REFILL_AMOUNT=3

# ── Bazaar ───────────────────────────────────────────────────────────────────
BAZAAR_URL=http://localhost:3001
BAZAAR_BASE_URL=http://localhost:3001
PUBLIC_BAZAAR_URL=http://localhost:3001
PUBLIC_FACILITATOR_URL=http://localhost:3002
# Required, minimum 24 characters. Guards /catalog/ingest, which writes to the
# public catalog. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BAZAAR_INTERNAL_TOKEN=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=veridex_bazaar
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws
P2P_BOOTSTRAP_PEERS=

# ── Demo resource server (conformance only) ──────────────────────────────────
SELLER_ADDRESS=
SELLER_SECRET_KEY=
DEMO_SERVER_PORT=3003
DEMO_SERVER_URL=http://localhost:3003
PUBLIC_DEMO_SERVER_URL=http://localhost:3003
BUYER_SECRET_KEY=
# Native XLM's Stellar Asset Contract on testnet: SEP-41, no trustline needed.
PAYMENT_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
PAYMENT_AMOUNT=100000

LOG_LEVEL=info
