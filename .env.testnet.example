# Facilitator Testnet environment example
FACILITATOR_PUBLIC_KEY=G...   # funded facilitator public key
FACILITATOR_SECRET_KEY=S...   # facilitator secret (keep secret, do not commit)
STELLAR_NETWORK=testnet
FACILITATOR_PORT=3002
FACILITATOR_HOST=0.0.0.0
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Safe default: use the facilitator signer without a channel pool.
CHANNEL_POOL_SIZE=0
CHANNEL_SECRET_KEYS=
CHANNEL_AUTO_CREATE=false
CHANNEL_COOLDOWN_MS=5000
CHANNEL_STARTING_BALANCE=5
CHANNEL_REFILL_THRESHOLD=2
CHANNEL_REFILL_AMOUNT=3
# Optional: fee-bump signer
FEE_BUMP_SIGNER_SECRET=
BAZAAR_INTERNAL_TOKEN=
BAZAAR_STELLAR_SECRET_KEY=
P2P_ANNOUNCED_RESOURCES=[]
