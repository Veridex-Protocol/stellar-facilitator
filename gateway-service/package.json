{
  "name": "@veridex/x402-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Secure HTTPS edge adapter that puts Stellar x402 in front of an existing API",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "veridex-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "init": "tsx src/cli.ts init",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@stellar/stellar-sdk": "16.2.0",
    "@veridex/stellar": "file:../sdk-typescript",
    "@x402/core": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/hono": "2.21.0",
    "@x402/stellar": "2.21.0",
    "dotenv": "17.2.3",
    "hono": "4.13.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}