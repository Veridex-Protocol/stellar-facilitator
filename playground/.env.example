# Veridex x402 Playground
#
# The playground holds no keys and no funds. Buyer keypairs are generated in
# the visitor's browser, funded by Friendbot, and discarded when the tab closes.
# Everything below is public configuration handed to the browser at /api/config.

PLAYGROUND_PORT=3004
PLAYGROUND_HOST=0.0.0.0

# Services the browser talks to directly. All three must send permissive CORS
# headers, because the browser - not this server - is the client.
FACILITATOR_URL=http://localhost:3002
DEMO_SERVER_URL=http://localhost:3003
BAZAAR_URL=http://localhost:3001

# Stellar testnet. The playground refuses to start against pubnet: it hands
# out funded keypairs, and that is only ever appropriate on a test network.
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
EXPLORER_TX_URL=https://stellar.expert/explorer/testnet/tx

# The resource the demo server sells, and its price in atomic units.
# PAYMENT_ASSET is native XLM's Stellar Asset Contract: SEP-41, and the only
# SAC that needs no trustline - which is what makes onboarding a single click.
PAID_RESOURCE_PATH=/paid-resource
PAYMENT_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional: path to the conformance report rendered by the Evidence panel.
CONFORMANCE_REPORT=../conformance-report.json
