{
  "name": "@veridex/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Veridex x402 Playground - a hosted sandbox that pays on Stellar testnet and hands you the evidence to check it yourself",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "node scripts/build-web.mjs",
    "build:server": "tsc -p tsconfig.json",
    "dev": "node scripts/build-web.mjs --watch & tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "13.3.0",
    "@types/node": "22.20.1",
    "@x402/core": "2.21.0",
    "@x402/stellar": "2.21.0",
    "buffer": "^6.0.3",
    "esbuild": "0.25.10",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  }
}
