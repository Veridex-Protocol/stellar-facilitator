# Veridex Bazaar Discovery Service - Environment Configuration
# License: Apache-2.0

# HTTP Server
BAZAAR_PORT=3001
BAZAAR_HOST=0.0.0.0

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=veridex_bazaar
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# P2P Mesh
P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws
P2P_BOOTSTRAP_PEERS=
P2P_ANNOUNCED_RESOURCES=[]

# Stellar (optional - for publishing announcements)
STELLAR_SECRET_KEY=
BAZAAR_INTERNAL_TOKEN=
PROVIDER_AGGREGATE_ISSUER_SECRET_KEY=
PROVIDER_AGGREGATE_PUBLISHED_THRESHOLD=100
PROVIDER_AGGREGATE_PROVISIONAL_THRESHOLD=20
PROVIDER_AGGREGATE_AUTHORIZED_ISSUERS=
PROVIDER_QUALITY_AUTHORIZED_SIGNERS=

# Logging
LOG_LEVEL=info
