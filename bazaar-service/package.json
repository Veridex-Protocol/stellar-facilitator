{
  "name": "@veridex/bazaar-service",
  "version": "0.1.0",
  "description": "Veridex P2P Federated Bazaar Discovery Engine with PostgreSQL + pgvector hybrid search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bazaar-service": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "search:eval": "tsx src/search/eval/report.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --loader tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@libp2p/identify": "^4.1.12",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/kad-dht": "^16.4.2",
    "@libp2p/mplex": "^12.0.29",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/peer-id": "^6.0.14",
    "@libp2p/ping": "^3.1.11",
    "@libp2p/gossipsub": "^17.1.1",
    "@libp2p/tcp": "^11.0.26",
    "@libp2p/websockets": "^10.1.19",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "2.21.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "hono": "^4.5.0",
    "libp2p": "^3.3.8",
    "pg": "^8.12.0",
    "pgvector": "^0.2.0",
    "uint8arrays": "^6.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "x402",
    "bazaar",
    "discovery",
    "p2p",
    "libp2p",
    "postgresql",
    "pgvector",
    "stellar"
  ]
}
