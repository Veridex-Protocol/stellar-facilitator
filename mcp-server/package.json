{
  "name": "@veridex/mcp-server",
  "version": "0.1.0",
  "description": "Stellar discovery and payment tools exposed through Model Context Protocol",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stellar-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "2.21.0",
    "@x402/stellar": "2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-clients",
    "x402",
    "stellar",
    "discovery"
  ]
